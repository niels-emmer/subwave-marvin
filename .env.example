# Copy to .env and fill in. .env is gitignored; this file is not.
# Everything here points an agent at ONE station. No values are committed.

# Base URL of the station's admin API, e.g. http://127.0.0.1:7700 (a tunnel is fine).
SUBWAVE_BASE_URL=

# Admin HTTP Basic user.
SUBWAVE_ADMIN_USER=

# Admin HTTP Basic password.
SUBWAVE_ADMIN_PASS=

# Station password that gates listeners (settings.privacy.password on the station).
SUBWAVE_STATION_PASSWORD=

# Tier 2 only, optional: ssh host for full-fidelity reads (shows, schedule, backups).
SUBWAVE_HOST=

# Tier 2 only, optional: state dir on that host, usually /var/sub-wave inside the controller.
SUBWAVE_STATE_DIR=
