# Local credentials for pushing config to the live station.
# Copy to .env and fill in. Never commit that file.

# Admin HTTP Basic user.
SUBWAVE_ADMIN_USER=

# Admin HTTP Basic password.
SUBWAVE_ADMIN_PASS=

# Station password that gates listeners (settings.privacy.password on the station).
SUBWAVE_STATION_PASSWORD=

# Admin API base URL, normally the ssh tunnel described in docs/PLAN.md 5.1.
SUBWAVE_BASE_URL=
